rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Funções de checagem básicas
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    match /users/{userId} {
      // Perfil é público (pra galera ver o rank e as contribuições)
      allow read: if isAuthenticated();
      // Ninguém mexe no perfil dos outros, só o próprio dono
      allow write: if isOwner(userId);
    }

    match /decks/{deckId} {
      // Lê se for público ou se for o dono
      allow read: if resource.data.isPublic == true || (isAuthenticated() && request.auth.uid == resource.data.uid);
      // Pra criar, o UID de quem cria tem que bater com o payload
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.uid;
      
      // Pra atualizar: ou é o dono, ou qualquer um pode só dar like/comentar (atualizando só os contadores)
      allow update: if isAuthenticated() && (
        isOwner(resource.data.uid) || 
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'commentsCount']))
      );
      allow delete: if isOwner(resource.data.uid);

      match /likes/{userId} {
        allow read: if isAuthenticated();
        // Impede de darem like usando o ID de outra pessoa
        allow create, delete: if isOwner(userId);
      }
    }

    match /teams/{teamId} {
      // Mesma lógica de segurança dos decks
      allow read: if resource.data.isPublic == true || (isAuthenticated() && request.auth.uid == resource.data.uid);
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.uid;
      
      allow update: if isAuthenticated() && (
        isOwner(resource.data.uid) || 
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'commentsCount']))
      );
      allow delete: if isOwner(resource.data.uid);

      match /likes/{userId} {
        allow read: if isAuthenticated();
        allow create, delete: if isOwner(userId);
      }
    }

    match /comments/{commentId} {
      // Comentários são abertos pra leitura geral
      allow read: if true;
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.uid;
      allow update, delete: if isAuthenticated() && request.auth.uid == resource.data.uid;
    }
  }
}